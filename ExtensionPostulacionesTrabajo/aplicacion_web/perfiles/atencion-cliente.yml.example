# Perfiles de ejemplo — COPIÁ ESTE ARCHIVO Y RENOMBRÁLO A .yml

id: atencion-cliente

nombre: Atención al Cliente

busqueda:
  # Ojo con este perfil: las ofertas de atención al cliente describen
  # actividades y volúmenes ("30 llamados por hora"), no skills con nombre
  # técnico. Por eso el puntaje va a depender mucho más de estas keywords que
  # del catálogo.
  keywords:
    - atención al cliente
    - call center
    - mesa de ayuda
    - reclamos
    - cobranzas
  ubicaciones: []
    # - CABA
  modalidades:
    - remoto
    - híbrido
    - presencial
  seniority:
    - junior
    - semi-senior
    - senior
  excluir: []

cv:
  # Texto que la extensión de Firefox escribe en el campo de presentación del
  # formulario. Es fijo y lo escribís vos: la versión que se arma según cada
  # oferta es la fase 14, y depende de la 11, que está trabada porque
  # `evidencia` está vacía en los perfiles y un modelo que la inventa te manda a
  # entrevistas por cosas que no hiciste.
  #
  # presentacion: |
  #   Hola. Soy Ada y hago soporte de escritorio desde 2018.
  contacto:
    nombre: Tu
    apellido: Nombre
    email: tu.email@ejemplo.com
    telefono: "+54 9 11 0000-0000"
    ciudad: Tu Ciudad
    linkedin: "https://linkedin.com/in/tu-usuario"

  # Mismas reglas que en los otros perfiles: evidencia en null hasta que la
  # completes con algo real. Acá pesa más: en atención al cliente casi todo el
  #Matching se decide con la evidencia, porque las skills nombradas son pocas.
  skills:
    - nombre: Atención al Cliente
      obligatorio: true
      evidencia: null
      anios: null

    - nombre: Contact Center
      alias: ["call center", "BPO"]
      obligatorio: true
      evidencia: null
      anios: null

    - nombre: Manejo de Reclamos
      alias: ["reclamos", "quejas"]
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: Escalamiento
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: Retención de Clientes
      alias: ["retención", "fidelización"]
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: Resolución de Conflictos
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: Zendesk
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: Salesforce
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: SLA
      obligatorio: false
      evidencia: null
      anios: null

    - nombre: Comunicación
      alias: ["comunicación efectiva"]
      obligatorio: false
      evidencia: null
      anios: null

  experiencia: []
    # - puesto: Analista de Atención al Cliente
    #   empresa: Empresa Ejemplo
    #   desde: 2023-01-01
    #   hasta: null
    #   descripcion: |
    #     Recepción de llamados, gestión de reclamos y escalamiento a segundo nivel.
    #   skills: ["Atención al Cliente", "Manejo de Reclamos", "Zendesk"]

  educacion: []
  idiomas:
    - idioma: Español
      nivel: Nativo
    - idioma: Inglés
      nivel: null   # En este rubro el inglés suele filtrar la mitad de las ofertas.
  certificaciones: []