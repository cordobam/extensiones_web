# Conexión a PostgreSQL. En Windows: localhost. En WSL: host.docker.internal o la IP del host.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/radar_laboral

# Secretos de los perfiles cuando se carguen desde la UI (futuro).
SECRET_KEY=cambiar-en-produccion

# Ventana temporal por defecto, en días, para el filtro de ofertas nuevas.
DIAS_POR_DEFECTO=2

# Pausa entre peticiones al portal de empleo, en segundos. Sé respetuoso.
REQUEST_DELAY=2.0

# Fuentes de ofertas que corren en cada ingesta, en el orden que se escriban.
# Disponibles: computrabajo, zonajobs. Para una corrida puntual está el flag
# `radar ingest --fuente`, que no toca este archivo.
FUENTES_ACTIVAS=computrabajo,zonajobs
